void ACiazPawn::BuildBodyCollision(){
 TArray<TArray<FVector>> Hulls;
 TArray<FVector> Vertices;TArray<int32> Triangles;
 for(const auto& Range:CiazCollisionData::HullRanges){
  TArray<FVector> Hull;Hull.Reserve(Range.VertexCount);
  for(int32 I=0;I<Range.VertexCount;++I){
   const auto& P=CiazCollisionData::Positions[Range.FirstVertex+I];
   Hull.Add(FVector(P[0],P[1],P[2]));
  }
  const int32 Base=Vertices.Num();Vertices.Append(Hull);Hulls.Add(Hull);
  for(int32 I=0;I<Range.IndexCount;++I)
   Triangles.Add(Base+CiazCollisionData::Indices[Range.FirstIndex+I]);
 }
 Body->CreateMeshSection_LinearColor(0,Vertices,Triangles,TArray<FVector>(),TArray<FVector2D>(),TArray<FLinearColor>(),TArray<FProcMeshTangent>(),false);
 Body->SetMeshSectionVisible(0,false);Body->SetCollisionConvexMeshes(Hulls);CollisionReady=true;
}
